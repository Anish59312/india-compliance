# Copy to .env and edit. Every value below is the default the UI suite already uses,
# so an empty .env behaves identically.
#
# Nothing loads .env automatically. Use it one of two ways:
#   source .env && <bench>/env/bin/pytest        # the suite
#   act --env-file .env -W .github/workflows/ui-tests.yml   # act reads it by default

# Site the tests drive. Must have the app installed and <app>.tests.before_tests run.
SITE=ic_test.localhost

# Port serving that site. The running `bench start` is on 8000, and the dev server
# resolves the site from the Host header, so 8000 works for any site.
SITE_PORT=8000

# Overrides SITE/SITE_PORT entirely when set.
# BASE_URL=http://ic_test.localhost:8000

# Desk user the suite logs in as, once per session.
FRAPPE_USER=Administrator
ADMIN_PASSWORD=admin

# Only needed when the bench is not three directories above ui_tests/, e.g. when the
# app is symlinked into apps/ rather than cloned.
# FRAPPE_SITES_PATH=/Users/anish/Workspace/frappe/dev/sites

# Set by GitHub Actions. Locally it only adds the chromium sandbox flags.
# CI=true
